# Copy to .env and fill in. Never commit .env.

# Telegram — https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional, for servers/CI: output of `kazemo login telegram`
TELEGRAM_SESSION=

# Threads — Meta for Developers → Threads API (long-lived access token)
THREADS_ACCESS_TOKEN=

# YouTube — Google Cloud Console → YouTube Data API v3 → API key
YOUTUBE_API_KEY=

# Collection agent (kazemo agent) — https://platform.claude.com → API keys
ANTHROPIC_API_KEY=

# Threads via Apify (kazemo collect threads-apify) — https://console.apify.com → Settings → API & Integrations
APIFY_TOKEN=
# Optional: the actor's sessionId input, if the actor requires it
APIFY_THREADS_SESSION=
